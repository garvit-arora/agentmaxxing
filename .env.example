# 1. Azure OpenAI credentials (default AI provider — no Gemini used)
#    Find these in https://portal.azure.com -> your Azure OpenAI resource -> Keys and Endpoint,
#    and Model deployments for the deployment name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# 2. (Optional) Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# 3. (Optional) Reasoning effort sent with each chat request.
#    Reasoning models (e.g. gpt-6-sol) REJECT function tools unless this is "none".
#    Keep "none" for tool use; use low|medium|high only if your deployment supports tools + reasoning; empty = omit.
AZURE_OPENAI_REASONING_EFFORT=none

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=
